{
  "name": "open-agent-builder",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/check-dependencies.cjs",
    "dev": "npx convex codegen && node --max-old-space-size=2048 --max-http-header-size=32768 node_modules/next/dist/bin/next dev",
    "dev:all": "concurrently \"npx convex dev\" \"npm run dev\"",
    "build": "npx convex codegen && next build",
    "build:prod": "npx convex codegen --prod && next build",
    "start": "node --max-http-header-size=32768 node_modules/next/dist/bin/next start",
    "start:prod": "next start -p 3001",
    "lint": "eslint .",
    "migrate:dry-run": "node scripts/migrate-keys-to-convex.cjs --dry-run",
    "migrate:dev": "node scripts/migrate-keys-to-convex.cjs",
    "migrate:prod": "node scripts/migrate-keys-to-convex.cjs --prod",
    "convex:env": "npx convex env list",
    "convex:env:prod": "npx convex env list --prod",
    "env:dev": "node scripts/switch-env.js dev",
    "env:prod": "node scripts/switch-env.js prod",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:mcp": "playwright test tests/add-remote-mcp.spec.ts",
    "test:workflow": "node scripts/test-workflow.js",
    "test:all": "bash scripts/test-all-templates.sh",
    "test:simple": "PORT=3003 node scripts/test-workflow.js simple-scraper",
    "test:search": "PORT=3003 node scripts/test-workflow.js web-search",
    "test:price": "PORT=3003 node scripts/test-workflow.js price-tracker",
    "test:research": "PORT=3003 node scripts/test-workflow.js content-research",
    "test:data": "PORT=3003 node scripts/test-workflow.js data-extractor",
    "test:pagination": "PORT=3003 node scripts/test-workflow.js pagination-scraper",
    "test:approval": "PORT=3003 node scripts/test-workflow.js approval-workflow",
    "test:tools": "PORT=3003 node scripts/test-workflow.js agent-with-tools",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:deepwiki": "playwright test tests/add-deepwiki-mcp.spec.ts",
    "test:comprehensive": "playwright test tests/comprehensive-workflow-tests.spec.ts",
    "test:templates": "playwright test tests/template-verification.spec.ts",
    "test:streaming": "bash tests/streaming-tests.sh",
    "test:comprehensive:ui": "playwright test tests/comprehensive-workflow-tests.spec.ts --ui",
    "test:comprehensive:headed": "playwright test tests/comprehensive-workflow-tests.spec.ts --headed",
    "test:templates:ui": "playwright test tests/template-verification.spec.ts --ui",
    "test:templates:headed": "playwright test tests/template-verification.spec.ts --headed",
    "test:all:comprehensive": "npm run test:comprehensive && npm run test:templates && npm run test:streaming",
    "test:vector-db": "playwright test tests/vector-db.spec.ts",
    "test:vector-db:headed": "playwright test tests/vector-db.spec.ts --headed",
    "test:vector-db:e2e": "playwright test tests/vector-db-e2e.spec.ts",
    "test:vector-db:e2e:headed": "playwright test tests/vector-db-e2e.spec.ts --headed",
    "test:vector-db:all": "playwright test tests/vector-db.spec.ts tests/vector-db-e2e.spec.ts",
    "test:regression": "playwright test tests/model-regression.spec.ts",
    "test:regression:headed": "playwright test tests/model-regression.spec.ts --headed",
    "test:regression:report": "playwright test tests/model-regression.spec.ts && open test-reports/model-regression-*.html",
    "test:auth": "playwright test tests/authentication.spec.ts",
    "test:auth:headed": "playwright test tests/authentication.spec.ts --headed",
    "test:edge-cases": "playwright test tests/edge-cases.spec.ts",
    "test:edge-cases:headed": "playwright test tests/edge-cases.spec.ts --headed",
    "test:regression:full": "playwright test tests/comprehensive-regression.spec.ts",
    "test:regression:full:headed": "playwright test tests/comprehensive-regression.spec.ts --headed",
    "test:regression:full:report": "playwright test tests/comprehensive-regression.spec.ts && npx playwright show-report",
    "test:full-regression-suite": "playwright test tests/model-regression.spec.ts tests/comprehensive-regression.spec.ts tests/vector-db.spec.ts tests/vector-db-e2e.spec.ts",
    "test:full-regression-suite:headed": "playwright test tests/model-regression.spec.ts tests/comprehensive-regression.spec.ts tests/vector-db.spec.ts tests/vector-db-e2e.spec.ts --headed",
    "test:full-regression-suite:report": "playwright test tests/model-regression.spec.ts tests/comprehensive-regression.spec.ts tests/vector-db.spec.ts tests/vector-db-e2e.spec.ts && npx playwright show-report",
    "test:phase3": "playwright test tests/authentication.spec.ts tests/edge-cases.spec.ts tests/comprehensive-regression.spec.ts",
    "test:all:phase3": "npm run test:auth && npm run test:edge-cases && npm run test:regression:full",
    "regression": "npm run test:ux && npm run test:regression && npm run test:auth && npm run test:edge-cases && npm run test:comprehensive && npm run test:templates && npm run test:files && npm run test:security && npm run test:execution-persistence && npm run test:rate-limiter && npm run test",
    "regression:headed": "npm run test:regression:headed && npm run test:auth:headed && npm run test:edge-cases:headed && npm run test:comprehensive:headed && npm run test:templates:headed && npm run test:files:headed && npm run test:security:headed && npm run test:execution-persistence:headed && npm run test:rate-limiter:headed",
    "test:files": "playwright test tests/file-processing.spec.ts tests/file-upload-download.spec.ts tests/file-workflow-integration.spec.ts",
    "test:files:headed": "playwright test tests/file-processing.spec.ts tests/file-upload-download.spec.ts tests/file-workflow-integration.spec.ts --headed",
    "test:files:ui": "playwright test tests/file-processing.spec.ts tests/file-upload-download.spec.ts tests/file-workflow-integration.spec.ts --ui",
    "test:upload-download": "playwright test tests/file-upload-download.spec.ts",
    "test:upload-download:headed": "playwright test tests/file-upload-download.spec.ts --headed",
    "test:file-integration": "playwright test tests/file-workflow-integration.spec.ts",
    "test:file-integration:headed": "playwright test tests/file-workflow-integration.spec.ts --headed",
    "test:security": "playwright test tests/security-auth.spec.ts",
    "test:security:headed": "playwright test tests/security-auth.spec.ts --headed",
    "test:execution-persistence": "playwright test tests/execution-persistence.spec.ts",
    "test:execution-persistence:headed": "playwright test tests/execution-persistence.spec.ts --headed",
    "test:rate-limiter": "playwright test tests/rate-limiter.spec.ts",
    "test:rate-limiter:headed": "playwright test tests/rate-limiter.spec.ts --headed",
    "test:ux": "playwright test tests/user-experience-regression.spec.ts",
    "test:ux:headed": "playwright test tests/user-experience-regression.spec.ts --headed"
  },
