# Convex Database
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-domain.clerk.accounts.dev

# ====================
# CRITICAL SECURITY SETTINGS (REQUIRED)
# ====================

# Encryption Key for User API Keys (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# E2B Sandbox API Key (REQUIRED for Transform Nodes)
# Get your key at: https://e2b.dev
# Transform nodes execute user code and MUST run in secure sandboxes
E2B_API_KEY=

# ====================
# FIRECRAWL (REQUIRED)
# ====================
FIRECRAWL_API_KEY=fc-...

# ====================
# OPTIONAL: LLM Provider Keys
# ====================
# Users can provide their own keys in the UI, but these serve as defaults

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=sk-...

# Groq (Fast inference)
GROQ_API_KEY=gsk_...

# ====================
# OPTIONAL: Additional Services
# ====================

# Arcade.ai (AI-powered API integrations)
ARCADE_API_KEY=

# ====================
# OPTIONAL: Security Configuration
# ====================

# HTTP Node Domain Whitelist (comma-separated)
# If set, HTTP nodes can only make requests to these domains
# Supports wildcards: *.example.com
# Example: ALLOWED_HTTP_DOMAINS=api.example.com,*.trusted.com,public-api.io
# ALLOWED_HTTP_DOMAINS=

# ====================
# SETUP INSTRUCTIONS
# ====================

# 1. Copy this file to .env.local:
#    cp .env.example .env.local

# 2. Fill in REQUIRED variables:
#    - ENCRYPTION_KEY: Generate with crypto (see command above)
#    - E2B_API_KEY: Get from https://e2b.dev
#    - FIRECRAWL_API_KEY: Get from https://firecrawl.dev

# 3. Fill in Convex and Clerk credentials from your project dashboards

# 4. (Optional) Add LLM provider keys or let users provide their own

# 5. Run setup commands:
#    npm install
#    npx convex dev
#    npm run dev

# ====================
# SECURITY NOTES
# ====================

# - Never commit .env.local to git
# - Store ENCRYPTION_KEY securely (use secrets manager in production)
# - E2B_API_KEY is REQUIRED - transform nodes will fail without it
# - Rate limiting is enabled by default (10 workflow executions per minute)
# - SSRF protection blocks private IPs and cloud metadata endpoints
# - User API keys are encrypted with AES-256-GCM
# - All code execution runs in E2B sandboxes (no unsafe Function() calls)
