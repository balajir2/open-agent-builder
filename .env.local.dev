# ============================================
# Open Agent Builder - Development Environment
# ============================================
#
# IMPORTANT: API keys are stored in Convex environment, NOT here!
# This file only contains Next.js-specific configuration.
#
# To view system API keys: npm run convex:env
# To set new keys: npx convex env set KEY_NAME "value"
#

# ============================================
# Convex Database Connection (DEVELOPMENT)
# ============================================
CONVEX_DEPLOYMENT=dev:disciplined-quail-9
NEXT_PUBLIC_CONVEX_URL=https://disciplined-quail-9.convex.cloud
NEXT_PUBLIC_CONVEX_UPLOAD_ACTION_URL=https://disciplined-quail-9.convex.site/http/uploadFile

# ============================================
# Azure Authentication (REQUIRED)
# ============================================
AUTH_MICROSOFT_ID=your-azure-app-registration-client-id
AUTH_MICROSOFT_SECRET=your-azure-app-client-secret
AUTH_MICROSOFT_TENANT_ID=your-azure-tenant-id
AUTH_SECRET=your-nextauth-secret-for-session-encryption

# ============================================
# System API Keys - STORED IN CONVEX! ✅
# ============================================
# IMPORTANT: All API keys are stored in Convex environment variables.
# This file should NOT contain any API keys.
#
# To view system keys: npx convex env list
# To set new keys: npx convex env set KEY_NAME "value"
#
# The two-tier API key system:
# 1. User-specific keys (stored in Convex DB) - highest priority
# 2. System keys (stored in Convex environment) - fallback for all users
#
# All keys are retrieved from Convex via convex/apiKeys.ts functions.

# ============================================
# LangSmith Tracing (Optional)
# ============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=open-agent-builder-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
