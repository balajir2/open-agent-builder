# ============================================
# Open Agent Builder - Environment Variables
# ============================================
#
# This file shows the MINIMAL configuration needed in .env.local
#
# IMPORTANT: Most API keys should be stored in Convex environment,
# NOT in .env.local. See CLAUDE.md for the two-tier architecture.
#
# Quick Setup:
# 1. Copy this file to .env.local
# 2. Fill in the values below
# 3. Set system API keys in Convex (see below)
#

# ============================================
# REQUIRED: Convex Database Connection
# ============================================
# Get these from: https://dashboard.convex.dev

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_UPLOAD_ACTION_URL=https://your-deployment.convex.site/http/uploadFile

# ============================================
# REQUIRED: Clerk Authentication
# ============================================
# Get these from: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-domain.clerk.accounts.dev

# ============================================
# OPTIONAL: LangSmith Tracing
# ============================================
# For monitoring and debugging workflows
# Get your API key from: https://smith.langchain.com/
#
# NOTE: You can also set these in Convex instead:
#   npx convex env set LANGCHAIN_API_KEY "lsv2_pt_..."
#   npx convex env set LANGCHAIN_TRACING_V2 "true"

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=open-agent-builder
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================
# SYSTEM API KEYS - SET IN CONVEX, NOT HERE!
# ============================================
#
# DO NOT store API keys in .env.local in production!
# Use Convex environment variables instead:
#
# Development:
#   npx convex env set ENCRYPTION_KEY "<32-byte-base64-key>"
#   npx convex env set ANTHROPIC_API_KEY "sk-ant-..."
#   npx convex env set OPENAI_API_KEY "sk-..."
#   npx convex env set GROQ_API_KEY "gsk_..."
#   npx convex env set GOOGLE_API_KEY "AIzaSy..."
#   npx convex env set FIRECRAWL_API_KEY "fc-..."
#   npx convex env set E2B_API_KEY "e2b_..."
#   npx convex env set TAVILY_API_KEY "tvly-..."
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://your-domain.clerk.accounts.dev"
#
# Production (add --prod flag):
#   npx convex env set --prod ENCRYPTION_KEY "<32-byte-base64-key>"
#   npx convex env set --prod ANTHROPIC_API_KEY "sk-ant-..."
#   # ... etc
#
# Generate ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# List current keys:
#   npx convex env list          # Development
#   npx convex env list --prod   # Production
#
# Why Convex instead of .env.local?
# ✓ Production ready (works in Vercel/deployments)
# ✓ Team friendly (shared config)
# ✓ Secure (never exposed to client)
# ✓ Deployment-specific (different dev/prod keys)
#
# See CLAUDE.md for full documentation on the two-tier API key architecture.
